# Environment configuration example for TraceLens
# Copy to .env and configure local/remote model endpoints

# Ollama local runtime endpoint
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL_DEFAULT="llama3.2:3b"

# OpenAI-compatible free / proxy endpoints
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_DEFAULT="openrouter/free"
MODEL_1="poolside/laguna-s-2.1:free"  # 118 Billion
MODEL_2="thinkingmachines/inkling:free"  # 975 Billion

# Web server options
TRACELENS_HOST="127.0.0.1"
TRACELENS_PORT="8000"
DEBUG="false"
